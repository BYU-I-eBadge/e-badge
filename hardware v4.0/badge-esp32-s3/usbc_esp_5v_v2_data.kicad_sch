				(size 1.27 1.27)
			)
		)
		(uuid "87787aa2-1a4f-44a7-b54b-704d59f79128")
	)
	(text "For firmware dev:\n(Break before make)\nWhen sourcing power\nto an external USB device\nTurn OFF USB sink load switch\nthen turn ON the USB\nsource load switch.\nIf this is not respected\nustable power feedback loops \nmay occur."
		(exclude_from_sim no)
		(at 141.224 111.506 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a294d339-ee8e-45b3-9b20-4aa56d593839")
	)
