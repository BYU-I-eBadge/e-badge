	)
	(text "By default Sinking current is enabled\nand Sourcing curreing is disabled"
		(exclude_from_sim no)
		(at 207.518 111.506 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "16e1636e-4cfa-44a7-8ba5-546ab24b0bb3")
	)
	(text "USB_ID: Input to MCU\nHIGH when providing power (downstream device is power sink)\nLOW when recieving power (downstream device is power source)\n"
		(exclude_from_sim no)
		(at 104.902 42.672 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "275f7ff7-c4f5-4a81-a451-3e720c93770b")
	)
	(text "PORT tells the TUSB321AIRWBR\nwhat to adversise our device as \n(PWR source (High), PWR sink (LOW), or DRD (HI-Z)).\nIf automatic roles (or DRD) is desired\nconfigure this as an input so\nthe chip sees a HI-Z state.\nConfiguring PORT as a DRD is the standard option."
		(exclude_from_sim no)
		(at 215.9 54.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3211b246-3844-4780-afde-397c7555dfd3")
	)
	(text "ISET: 2A"
		(exclude_from_sim no)
		(at 150.368 145.542 0)
		(effects
