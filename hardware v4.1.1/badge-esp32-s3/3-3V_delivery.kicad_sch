	)
	(text "There are fixed and adjustable versions of this chip.\nWe perferably want to get the 3.3V fixed one but if\nwe can't an adjustable version with 75k and 24k resistor\nto set the FB will do.\nIf a fixed version is used, replace the R64 with 0R and\nDNP R19\n\n\nFixed version:\nAP63203WU-7 (C780769)\n\nAdjustable:\nAP63201WU-7 (C2071044)"
		(exclude_from_sim no)
		(at 110.998 144.018 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e7c24df0-9ef0-4d13-bad7-97e3fab24891")
	)
